def traversal(ar):
  print('[', end="")
  for i in range(len(ar)-1):
    print(ar[i],end=', ')
  print(ar[-1],end=']')
def insertElement(ar,el,ind):
  ar2=[0]*(len(ar)+1)
  for i in range(ind):
    ar2[i]=ar[i]
  for i in range(ind,len(ar)):
    ar2[i+1]=ar[i]
  ar2[ind]=el
  return ar2

