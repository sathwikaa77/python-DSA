a = 10
b = 3


print("ARITHMETIC OPERATORS")
print(a + b)
print(a - b)
print(a * b)
print(a / b)
print(a // b)
print(a % b)
print(a ** b)

print("COMPARISON OPERATORS")
print(a == b)
print(a != b)
print(a > b)
print(a < b)
print(a >= b)
print(a <= b)

print("ASSIGNMENT OPERATORS")
x = 10
x += 5
print(x)
x -= 2
print(x)
x *= 2
print(x)
x /= 3
print(x)
x //= 2
print(x)
x %= 3
print(x)
x **= 2
print(x)

print("LOGICAL OPERATORS")
p = True
q = False
print(p and q)
print(p or q)
print(not p)

print("BITWISE OPERATORS")
m = 5
n = 3
print(m & n)
print(m | n)
print(m ^ n)
print(~m)
print(m << 1)
print(m >> 1)

print("MEMBERSHIP OPERATORS")
numbers = [10, 20, 30, 40]
print(20 in numbers)
print(50 not in numbers)

print("IDENTITY OPERATORS")
list1 = [1, 2, 3]
list2 = list1
list3 = [1, 2, 3]
print(list1 is list2)
print(list1 is list3)
print(list1 is not list3)